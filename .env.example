# Project Thanh — environment variables (TEMPLATE ONLY, no real values).
# Copy to a secret store or an untracked file for a real deployment; never
# commit filled-in values. deploy/compose.local.yml sets well-known DEV values
# for local development only.

# --- shared ---------------------------------------------------------------
# local | closed_beta | open_beta | production. "local" enables DEV SAMPLE
# seeds, the dev TOTP key and logging e-mail codes to stdout.
THANH_ENV=
# PostgreSQL DSN used by game-server, transaction-service, migrate, beta-reset.
DATABASE_URL=
# Shared secret between game-server and transaction-service (>= 16 chars).
INTERNAL_API_TOKEN=

# --- transaction-service --------------------------------------------------
TRANSACTION_SERVICE_ADDR=:8082
# true: refuse every asset write unless a synchronous standby confirms the
# commit (P0-150, T-05). Required for Open Beta [CẦN CẤU HÌNH hạ tầng HA].
REQUIRE_SYNC_STANDBY=false

# --- game-server ----------------------------------------------------------
GAME_SERVER_ADDR=:8081
TRANSACTION_SERVICE_URL=http://localhost:8082
# Comma separated browser origins allowed for cookies/WebSocket (CSRF check).
ALLOWED_ORIGINS=
# 32-byte key (base64) encrypting TOTP secrets at rest. Required outside local.
TOTP_ENCRYPTION_KEY=
# true behind HTTPS (Secure cookies).
COOKIE_SECURE=true
# true only behind a trusted reverse proxy that sets X-Forwarded-For.
TRUST_PROXY_HEADERS=false

# --- client (Vite dev server) ---------------------------------------------
# Where /api, /admin/api and /ws are proxied during development.
GAME_SERVER_URL=http://localhost:8081

# --- tests ----------------------------------------------------------------
# A role that may CREATE DATABASE; each test package uses its own database.
TEST_DATABASE_URL=
